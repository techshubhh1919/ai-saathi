<!DOCTYPE html>
<html lang="hi" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>एआई साथी (AI Saathi) | राष्ट्रीय नागरिक व ग्रामीण डिजिटल सेवा मंच</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script src="tesseract.min.js"></script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', 'Noto Sans Devanagari', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: #F8FAFC;
    }
    
    .tiranga-accent {
      background: linear-gradient(90deg, #FF9933 0%, #FF9933 33.3%, #FFFFFF 33.3%, #FFFFFF 66.6%, #138808 66.6%, #138808 100%);
      height: 4px;
    }

    @keyframes audio-wave-anim {
      0%, 100% { height: 6px; }
      50% { height: 28px; }
    }
    .wave-bar {
      animation: audio-wave-anim 1.2s ease-in-out infinite;
    }

    .gov-card {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 1rem;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .gov-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 16px 32px -8px rgba(15, 23, 42, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
      border-color: #CBD5E1;
    }

    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulse-ring-anim {
      animation: pulse-ring 2s infinite ease-in-out;
    }
  </style>
</head>

<body class="min-h-full flex flex-col text-slate-900 antialiased selection:bg-amber-100 selection:text-amber-900">

  <!-- National Top Header -->
  <div class="tiranga-accent"></div>
  <div class="bg-slate-900 text-slate-300 text-xs py-1.5 px-4 sm:px-8 flex items-center justify-between border-b border-slate-800">
    <div class="flex items-center space-x-2">
      <span class="font-bold text-slate-200">🇮🇳 भारत सरकार | Government of India</span>
      <span class="text-slate-600">|</span>
      <span class="hidden sm:inline text-slate-400">डिजिटल भारत - अंत्योदय नागरिक सेवा मिशन</span>
    </div>
    <div class="flex items-center space-x-3 text-2xs">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-300 font-bold border border-emerald-800">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse mr-1.5"></span>
        AI साथी 24x7 ऑनलाइन
      </span>
      <button onclick="toggleSettingsModal()" class="hover:text-white transition-colors cursor-pointer flex items-center space-x-1">
        <span>⚙️</span><span class="hidden sm:inline">सेटिंग्स</span>
      </button>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <header class="bg-white/95 backdrop-blur-md border-b border-slate-200 sticky top-0 z-40 shadow-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between">
      
      <!-- Brand Logo -->
      <div class="flex items-center space-x-3">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-tr from-amber-600 via-orange-500 to-amber-500 flex items-center justify-center text-white font-extrabold text-xl shadow-md ring-2 ring-amber-100">
          🇮🇳
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="text-xl font-extrabold text-slate-900 tracking-tight">एआई साथी</span>
            <span class="text-xs px-2 py-0.5 rounded-md bg-amber-100 text-amber-900 font-bold border border-amber-200">AI Saathi</span>
          </div>
          <p class="text-2xs text-slate-500 font-medium">राष्ट्रीय नागरिक व ग्रामीण डिजिटल सेवा सहायक</p>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="hidden md:flex items-center space-x-1 bg-slate-100/80 p-1 rounded-xl border border-slate-200">
        <button onclick="switchTab('home')" id="tab-home" class="tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-white text-slate-900 shadow-xs">
          🎙️ मुख्य सहायक
        </button>
        <button onclick="switchTab('schemes')" id="tab-schemes" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all">
          📋 सरकारी योजनाएं
        </button>
        <button onclick="switchTab('docs')" id="tab-docs" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all">
          📑 दस्तावेज़ स्कैनर
        </button>
        <button onclick="switchTab('fraud')" id="tab-fraud" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all">
          🛡️ साइबर फ्रॉड जांच
        </button>
        <button onclick="switchTab('impact')" id="tab-impact" class="tab-btn px-4 py-2 rounded-lg text-xs font-medium text-slate-600 hover:text-slate-900 hover:bg-white/60 transition-all">
          📊 प्रेजेंटेशन
        </button>
      </nav>

      <!-- Language & Handsfree Toggle -->
      <div class="flex items-center space-x-2">
        <button 
          onclick="toggleTwoWayMode()" 
          id="twoway-btn" 
          class="px-3 py-1.5 rounded-lg border border-emerald-300 bg-emerald-50 text-emerald-900 hover:bg-emerald-100 text-xs font-bold flex items-center space-x-1.5 transition-all cursor-pointer shadow-2xs"
          title="दोतरफा निरंतर बातचीत ऑन/ऑफ करें"
        >
          <span id="twoway-icon" class="text-sm">🎧</span>
          <span id="twoway-label" class="hidden sm:inline">दोतरफा बातचीत: ऑन</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Bottom Tab Navigation -->
  <div class="md:hidden fixed bottom-0 left-0 right-0 bg-white border-t border-slate-200 z-50 px-2 py-1.5 flex justify-around shadow-lg">
    <button onclick="switchTab('home')" class="flex flex-col items-center text-xs font-bold text-amber-700 py-1">
      <span class="text-base">🎙️</span><span>सहायक</span>
    </button>
    <button onclick="switchTab('schemes')" class="flex flex-col items-center text-xs font-medium text-slate-600 py-1">
      <span class="text-base">📋</span><span>योजनाएं</span>
    </button>
    <button onclick="switchTab('docs')" class="flex flex-col items-center text-xs font-medium text-slate-600 py-1">
      <span class="text-base">📑</span><span>स्कैनर</span>
    </button>
    <button onclick="switchTab('fraud')" class="flex flex-col items-center text-xs font-medium text-slate-600 py-1">
      <span class="text-base">🛡️</span><span>सुरक्षा</span>
    </button>
  </div>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-10 mb-16 md:mb-8">

    <!-- VIEW 1: HOME -->
    <div id="view-home" class="space-y-10">

      <!-- Hero Section -->
      <section class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-white to-amber-50/40 border border-slate-200 shadow-xl p-6 sm:p-10 text-center">
        
        <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-amber-100/80 text-amber-900 border border-amber-300 text-xs font-bold mb-4 shadow-2xs">
          <span>🇮🇳</span>
          <span>डिजिटल भारत का प्रामाणिक नागरिक सेवा साथी</span>
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight max-w-3xl mx-auto">
          सरकारी सेवाओं व समस्याओं का <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 to-orange-600">सटीक चरण-दर-चरण</span> समाधान
        </h1>

        <p class="text-slate-600 text-sm sm:text-base max-w-2xl mx-auto mt-2 leading-relaxed">
          10वीं की मार्कशीट, आधार, ड्राइविंग लाइसेंस, ट्रैफिक चालान, पीएम-किसान, राशन कार्ड, या बिजली बिल — अपनी आम बोलचाल में बोलकर पूछें।
        </p>

        <!-- Conversational Turn-Taking Status Banner -->
        <div class="mt-4 inline-flex items-center space-x-2 text-xs font-semibold text-slate-600 bg-white px-3 py-1 rounded-full border border-slate-200 shadow-2xs">
          <span id="smart-mic-status">✨ दोतरफा बातचीत सक्रिय — बोलें, साथी सुनेगा और जवाब देगा</span>
        </div>

        <!-- ============================================================= -->
        <!-- SINGLE UNIFIED SMART MIC BUTTON (ONLY ONE BUTTON - NO DUPLICATES) -->
        <!-- ============================================================= -->
        <div class="mt-8 flex flex-col items-center justify-center">
          
          <div class="relative flex items-center justify-center">
            <div id="smart-mic-ring" class="hidden absolute w-36 h-36 rounded-full bg-amber-400/20 pulse-ring-anim"></div>
            
            <button 
              type="button" 
              id="smart-mic-btn" 
              onclick="toggleSmartMic()" 
              class="relative z-10 w-24 h-24 rounded-full bg-gradient-to-tr from-amber-500 via-orange-500 to-amber-600 text-white shadow-2xl hover:shadow-amber-500/40 flex items-center justify-center cursor-pointer transition-all duration-300 transform hover:scale-105 active:scale-95 ring-4 ring-white"
              title="माइक दबाकर सवाल पूछें या रोकने के लिए दबाएं"
            >
              <span id="smart-mic-icon" class="text-4xl select-none">🎙️</span>
            </button>
          </div>

          <p id="smart-mic-label" class="mt-4 text-sm font-bold text-slate-800 tracking-wide select-none">
            माइक दबाकर सवाल पूछें
          </p>

          <div id="smart-mic-waves" class="hidden flex items-center space-x-1.5 h-8 mt-2">
            <div class="w-1 bg-amber-600 rounded-full wave-bar" style="animation-delay: 0.1s"></div>
            <div class="w-1.5 bg-orange-500 rounded-full wave-bar" style="animation-delay: 0.3s"></div>
            <div class="w-1 bg-amber-600 rounded-full wave-bar" style="animation-delay: 0.15s"></div>
            <div class="w-1.5 bg-orange-400 rounded-full wave-bar" style="animation-delay: 0.4s"></div>
            <div class="w-1 bg-amber-600 rounded-full wave-bar" style="animation-delay: 0.2s"></div>
            <span class="text-2xs font-extrabold text-amber-900 ml-2 animate-pulse">आवाज़ सक्रिय...</span>
          </div>

        </div>

        <!-- TEXT SEARCH BAR -->
        <div class="mt-8 max-w-xl mx-auto">
          <form onsubmit="handleTextSubmit(event)" class="relative flex items-center">
            <input 
              type="text" 
              id="user-text-query" 
              placeholder="या यहाँ लिखकर पूछें (उदा: 10 की मार्कशीट कैसे डाउनलोड करें, चालान, किसान...)" 
              class="w-full pl-4 pr-24 py-3 rounded-2xl bg-white border border-slate-300 shadow-sm text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all placeholder:text-slate-400 font-medium"
            />
            <button 
              type="submit" 
              class="absolute right-1.5 px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold transition-all cursor-pointer shadow-xs"
            >
              पूछें ➔
            </button>
          </form>
        </div>

        <!-- POPULAR CITIZEN QUERY PILLS -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 max-w-4xl mx-auto">
          <span class="text-2xs font-bold text-slate-500 uppercase tracking-wider mr-1">अक्सर पूछे जाने वाले:</span>
          
          <button onclick="askPreset('मुझे बताओ कि 10 की मार्कशीट कैसे डाउनलोड करें।')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>📜</span><span>10वीं/12वीं मार्कशीट</span>
          </button>
          
          <button onclick="askPreset('आधार कार्ड कैसे डाउनलोड करें?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🆔</span><span>आधार डाउनलोड</span>
          </button>

          <button onclick="askPreset('ड्राइविंग लाइसेंस कैसे बनवाएं?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🚗</span><span>ड्राइविंग लाइसेंस</span>
          </button>

          <button onclick="askPreset('ट्रैफिक चालान कैसे भरें?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🚦</span><span>ट्रैफिक चालान</span>
          </button>

          <button onclick="askPreset('पीएम किसान सम्मान निधि की किस्त नहीं आई')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🌾</span><span>पीएम-किसान 18वीं किस्त</span>
          </button>

          <button onclick="askPreset('राशन कार्ड में नया नाम कैसे जोड़ें?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🍚</span><span>राशन कार्ड में नाम</span>
          </button>

          <button onclick="askPreset('PF बैलेंस कैसे चेक करें?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>💼</span><span>PF बैलेंस चेक</span>
          </button>

          <button onclick="askPreset('बिजली का बिल ज्यादा आ गया सुधार कैसे करें?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>⚡</span><span>बिजली बिल सुधार (1912)</span>
          </button>

          <button onclick="askPreset('आयुष्मान कार्ड कैसे बनेगा?')" class="px-3 py-1.5 rounded-full bg-white hover:bg-amber-50 text-slate-700 hover:text-amber-900 border border-slate-200 text-xs font-bold transition-all shadow-2xs flex items-center space-x-1 cursor-pointer">
            <span>🏥</span><span>आयुष्मान ₹5 लाख कार्ड</span>
          </button>
        </div>

        <!-- SPEECH & ANSWER BUBBLE (CLEAN) -->
        <div id="speech-bubble" class="hidden mt-8 max-w-3xl mx-auto text-left transition-all duration-300">
          <div class="gov-card p-6 bg-amber-50/70 border-amber-200/80 shadow-md">
            
            <div class="flex items-start justify-between border-b border-amber-200/80 pb-3 mb-4">
              <div>
                <span class="text-2xs font-extrabold uppercase px-2 py-0.5 rounded bg-amber-200 text-amber-900">
                  ❓ आपने पूछा:
                </span>
                <p id="speech-transcript" class="text-base sm:text-lg font-bold text-slate-900 mt-1 italic">
                  "..."
                </p>
              </div>
              <div class="flex items-center space-x-2 shrink-0">
                <button onclick="speakText(currentAnswer)" class="text-xs font-bold px-3 py-1 rounded-lg bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 flex items-center space-x-1 shadow-2xs cursor-pointer">
                  <span>🔊</span><span>पुनः सुनें</span>
                </button>
              </div>
            </div>

            <div class="space-y-2">
              <div class="flex items-center space-x-2">
                <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                <span class="text-xs font-extrabold text-emerald-900 uppercase tracking-wider">
                  एआई साथी का प्रमाणित समाधान:
                </span>
              </div>
              <div id="speech-answer" class="text-xs sm:text-sm text-slate-800 leading-relaxed font-normal whitespace-pre-line pl-4 border-l-2 border-emerald-500">
                साथी सटीक समाधान तैयार कर रहा है...
              </div>
            </div>

          </div>
        </div>

      </section>

      <!-- OFFICIAL GOVERNMENT NOTICES & SCHEMES (REDESIGNED ULTRA-PREMIUM) -->
      <section class="space-y-4">
        
        <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-2 border-b border-slate-200 gap-2">
          <div>
            <div class="flex items-center space-x-2">
              <span class="text-xl">📢</span>
              <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">राष्ट्रीय सूचना पट्ट व प्रमुख सरकारी योजनाएं</h2>
            </div>
            <p class="text-xs text-slate-500 mt-0.5">
              भारत सरकार के सत्यापित आधिकारिक पोर्टल लिंक, दिशानिर्देश व ऑनलाइन आवेदन सुविधाएं
            </p>
          </div>
          <span class="px-3 py-1 rounded-full bg-emerald-100 text-emerald-900 text-xs font-bold border border-emerald-300 self-start sm:self-center">
            ✓ 100% सत्यापित सरकारी पोर्टल
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          
          <!-- Card 1: PM Surya Ghar -->
          <div class="gov-card p-5 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-2xs font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-900 border border-amber-200 flex items-center space-x-1">
                  <span>☀️</span><span>नवीन व नवीकरणीय ऊर्जा मंत्रालय</span>
                </span>
                <span class="text-3xs font-bold text-slate-400">2024-2026</span>
              </div>
              <h3 class="text-base font-extrabold text-slate-900">पीएम सूर्य घर: मुफ्त बिजली योजना</h3>
              <div class="bg-amber-50/80 rounded-lg p-2.5 border border-amber-100 text-xs text-amber-950 font-medium space-y-1">
                <p>⚡ <strong>300 यूनिट मुफ्त बिजली</strong> हर महीने घर में।</p>
                <p>💰 सीधे बैंक खाते में <strong>₹78,000 की सरकारी सब्सिडी</strong>।</p>
              </div>
              <p class="text-2xs text-slate-500">
                <strong>पात्रता:</strong> बिजली बिल, आधार कार्ड व छत की जगह।
              </p>
            </div>
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <a href="https://pmsuryaghar.gov.in" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold flex items-center space-x-1 shadow-2xs transition-all">
                <span>पोर्टल पर जाएं</span>
                <span>↗</span>
              </a>
              <button onclick="speakText('पीएम सूर्य घर मुफ्त बिजली योजना में 300 यूनिट तक मुफ्त बिजली और 78 हजार रुपये की सीधी सरकारी सब्सिडी मिलती है।')" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold flex items-center space-x-1 transition-all cursor-pointer">
                <span>🔊</span><span>सुनें</span>
              </button>
            </div>
          </div>

          <!-- Card 2: PM Vishwakarma -->
